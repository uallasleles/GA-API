# Copie este arquivo para .env e preencha com os valores reais.
# NUNCA versionar o .env real.

# ATIVAR EM PRODUÇÃO?
IS_PRODUCTION=True

# CONFIGURAÇÃO DO BANCO DE DADOS ORACLE (ERP WinThor, modo thin, sem Instant Client)
ORACLEDB_USERNAME=
ORACLEDB_PASSWORD=
ORACLEDB_DSN=

# CONFIGURAÇÕES DA API DO LOGGER
LOGGER_API_URL=
LOGGER_API_KEY=

# AUTENTICAÇÃO (JWT)
# Gerar com: openssl rand -hex 32
JWT_SECRET_KEY=
MYAPI_ACCESS_TOKEN_EXPIRE_MINUTES=30

# LOGIN DE ACESSO A /docs (Swagger UI) E /openapi.json
DOCS_USERNAME=
DOCS_PASSWORD=
# Gerar com: openssl rand -hex 32
DOCS_SESSION_SECRET=

# PAINEL ADMIN (/admin) - login usa os usuarios do Postgres com o scope "admin"
# Gerar com: openssl rand -hex 32
ADMIN_SESSION_SECRET=

# BANCO DE DADOS DA APLICAÇÃO (Postgres - usuários/credenciais)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=gaapi
# Montado automaticamente no docker-compose.yml a partir das variáveis acima:
# DATABASE_URL=postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# RHGESTOR (SOLIDES) - envio de CSVs (/RHGestor/*). Credenciais SOMENTE aqui/Portainer; nunca no codigo.
# A URL e a mesma para teste e producao; quem define a base e a credencial.
# Producao so e usada se RHGESTOR_EMAIL_PRODUCAO e RHGESTOR_KEY_PRODUCAO estiverem preenchidos.
RHGESTOR_BASE_URL=https://apisecure.rhgestor.com.br
RHGESTOR_EMAIL_TESTE=
RHGESTOR_KEY_TESTE=
RHGESTOR_EMAIL_PRODUCAO=
RHGESTOR_KEY_PRODUCAO=
