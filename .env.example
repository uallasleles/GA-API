# Copie este arquivo para .env e preencha com os valores reais.
# NUNCA versionar o .env real.

# ATIVAR EM PRODUÇÃO?
IS_PRODUCTION=True

# CONFIGURAÇÃO API REPOM (produção)
API_BASE_URL=
API_SERVER=
API_GRANT_TYPE=password
API_VERSION=3.0
API_TIMEOUT=60

# PRODUÇÃO - Chocosul
API_USERNAME_CHOCOSUL=
API_PASSWORD_CHOCOSUL=
API_PARTNER_CHOCOSUL=

# PRODUÇÃO - Mastter
API_USERNAME_MASTTER=
API_PASSWORD_MASTTER=
API_PARTNER_MASTTER=

# PRODUÇÃO - LazaroLog
API_USERNAME_LAZAROLOG=
API_PASSWORD_LAZAROLOG=
API_PARTNER_LAZAROLOG=

# Fallback (usado quando nenhum parceiro específico é informado)
API_USERNAME=
API_PASSWORD=
API_PARTNER=

# CONFIGURAÇÃO DO BANCO DE DADOS ORACLE (ERP WinThor, modo thin, sem Instant Client)
ORACLEDB_USERNAME=
ORACLEDB_PASSWORD=
ORACLEDB_DSN=

# CONFIGURAÇÕES DA API DO LOGGER
LOGGER_API_URL=
LOGGER_API_KEY=

# AUTENTICAÇÃO (JWT)
# Gerar com: openssl rand -hex 32
JWT_SECRET_KEY=
MYAPI_ACCESS_TOKEN_EXPIRE_MINUTES=30

# BANCO DE DADOS DA APLICAÇÃO (Postgres - usuários/credenciais)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=ga_api
# Montado automaticamente no docker-compose.yml a partir das variáveis acima:
# DATABASE_URL=postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}
